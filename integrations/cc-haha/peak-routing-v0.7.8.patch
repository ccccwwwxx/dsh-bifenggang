+
+  async getConfig(): Promise<{ config: PeakRoutingConfig; revision: string; exists: boolean }> {
+    const defaults = await this.resolveDefaultConfig()
+    const filePath = this.getConfigPath()
+    let exists = false
+    let revision = '0'
+    try {
+      const stat = await fs.stat(filePath)
