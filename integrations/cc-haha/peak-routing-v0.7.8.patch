new file mode 100644
index 0000000..69c42ad
--- /dev/null
+++ b/desktop/src/pages/settings/PeakRoutingSettings.tsx
@@ -0,0 +1,468 @@
+import { useCallback, useEffect, useMemo, useState } from 'react'
+import { FlaskConical, RefreshCw, Save } from 'lucide-react'
+
+import {
+  peakRoutingApi,
+  type PeakRoutingCatalog,
+  type PeakRoutingCatalogModel,
+  type PeakRoutingStatus,
+  type PeakRoutingVerdict,
+} from '../../api/peakRouting'
+import { ApiError } from '../../api/client'
+import { Button } from '@/components/ui/Button'
+import { Input } from '@/components/ui/Input'
+import { SelectField } from '@/components/ui/SelectField'
+import { TextArea } from '@/components/ui/TextArea'
+import {
+  SettingsBlock,
+  SettingsGroup,
+  SettingsPageHeader,
+  SettingsRow,
+  SettingsSection,
+  SettingsSwitchRow,
+} from '@/components/settings/SettingsSection'
+import { useTranslation } from '../../i18n'
+import { MODEL_REASONING_EFFORTS, type ModelReasoningEffort } from '../../../../src/shared/modelReasoning'
+import {
+  formatPeakWindow,
+  isValidDateOnly,
+  type PeakRoutingConfig,
+  type PeakRoutingSelection,
+} from '../../../../src/shared/peakRouting'
+
+type RouteKind = 'defaultRoute' | 'peakRoute' | 'abstractRoute'
+
+const ROUTE_KINDS: Array<{ key: RouteKind; labelKey: 'peakRouting.route.default' | 'peakRouting.route.peak' | 'peakRouting.route.abstract'; hintKey: 'peakRouting.route.defaultHint' | 'peakRouting.route.peakHint' | 'peakRouting.route.abstractHint' }> = [
+  { key: 'defaultRoute', labelKey: 'peakRouting.route.default', hintKey: 'peakRouting.route.defaultHint' },
+  { key: 'peakRoute', labelKey: 'peakRouting.route.peak', hintKey: 'peakRouting.route.peakHint' },
+  { key: 'abstractRoute', labelKey: 'peakRouting.route.abstract', hintKey: 'peakRouting.route.abstractHint' },
+]
+
+export function PeakRoutingSettings() {
+  const t = useTranslation()
+  const [config, setConfig] = useState<PeakRoutingConfig | null>(null)
+  const [revision, setRevision] = useState('0')
+  const [catalog, setCatalog] = useState<PeakRoutingCatalog | null>(null)
+  const [status, setStatus] = useState<PeakRoutingStatus | null>(null)
+  const [holidaysText, setHolidaysText] = useState('')
+  const [holidaysError, setHolidaysError] = useState<string | null>(null)
+  const [saving, setSaving] = useState(false)
+  const [message, setMessage] = useState<{ tone: 'ok' | 'error'; text: string } | null>(null)
+  const [testText, setTestText] = useState('')
+  const [testVerdict, setTestVerdict] = useState<PeakRoutingVerdict | null>(null)
+  const [testBusy, setTestBusy] = useState(false)
+
+  const applyConfig = useCallback((next: PeakRoutingConfig, nextRevision: string) => {
+    setConfig(next)
+    setRevision(nextRevision)
+    setHolidaysText(next.holidays.join('\n'))
+    setHolidaysError(null)
+  }, [])
+
+  const load = useCallback(async () => {
+    setMessage(null)
+    try {
+      const [configResult, catalogResult, statusResult] = await Promise.all([
+        peakRoutingApi.get(),
+        peakRoutingApi.catalog(),
+        peakRoutingApi.status(),
+      ])
+      applyConfig(configResult.config, configResult.revision)
+      setCatalog(catalogResult)
+      setStatus(statusResult)
+    } catch (error) {
+      setMessage({ tone: 'error', text: describeError(error) })
+    }
+  }, [applyConfig])
+
+  useEffect(() => {
+    void load()
+  }, [load])
+
+  useEffect(() => {
+    let cancelled = false
+    const timer = window.setInterval(() => {
+      void peakRoutingApi.status().then(next => {
+        if (!cancelled) setStatus(next)
+      }).catch(() => {})
+    }, 60_000)
+    return () => {
+      cancelled = true
+      window.clearInterval(timer)
+    }
+  }, [])
+
+  const providers = catalog?.providers ?? []
+  const providerOptions = useMemo(() => {
+    const options = providers.map(provider => ({ value: provider.providerId, label: provider.providerName }))
+    if (config) {
+      for (const route of [config.defaultRoute, config.peakRoute, config.abstractRoute, config.classifier]) {
+        if (route.providerId && !options.some(option => option.value === route.providerId)) {
+          options.push({ value: route.providerId, label: `${route.providerId} (${t('peakRouting.route.unavailable')})` })
+        }
+      }
+    }
+    return options
+  }, [providers, config, t])
+
+  const updateRoute = (kind: RouteKind, patch: Partial<PeakRoutingSelection>) => {
+    setConfig(current => current ? { ...current, [kind]: { ...current[kind], ...patch } } : current)
+  }
+
+  const updateClassifier = (patch: Partial<PeakRoutingConfig['classifier']>) => {
+    setConfig(current => current ? { ...current, classifier: { ...current.classifier, ...patch } } : current)
+  }
+
+  const onProviderChange = (kind: RouteKind, providerId: string) => {
+    const model = firstModel(providers, providerId)
+    updateRoute(kind, {
+      providerId,
+      modelId: model?.modelId ?? '',
+      effortLevel: defaultEffort(model, config?.[kind].effortLevel ?? 'medium'),
+    })
+  }
+
+  const onModelChange = (kind: RouteKind, modelId: string) => {
+    if (!config) return
+    const model = findModel(providers, config[kind].providerId, modelId)
+    updateRoute(kind, { modelId, effortLevel: defaultEffort(model, config[kind].effortLevel) })
+  }
+
+  const onClassifierProviderChange = (providerId: string) => {
+    const model = firstModel(providers, providerId)
+    updateClassifier({ providerId, modelId: model?.modelId ?? '' })
+  }
+
+  const save = async () => {
+    if (!config) return
+    const parsed = parseHolidays(holidaysText)
+    if (parsed.invalid.length > 0) {
+      setHolidaysError(t('peakRouting.holidays.invalid', { count: parsed.invalid.length }))
+      return
+    }
+    setSaving(true)
+    setMessage(null)
+    try {
+      const result = await peakRoutingApi.update({ ...config, holidays: parsed.dates }, revision)
+      applyConfig(result.config, result.revision)
+      setMessage({ tone: 'ok', text: t('peakRouting.saved') })
+      setStatus(await peakRoutingApi.status())
+    } catch (error) {
+      if (error instanceof ApiError && error.status === 409) {
+        setMessage({ tone: 'error', text: t('peakRouting.conflict') })
+        await load()
+      } else {
+        setMessage({ tone: 'error', text: describeError(error) })
+      }
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  const runClassifierTest = async () => {
+    if (!testText.trim()) return
+    setTestBusy(true)
+    setTestVerdict(null)
+    try {
+      const result = await peakRoutingApi.classifyTest(testText)
+      setTestVerdict(result.verdict)
+    } catch (error) {
+      setMessage({ tone: 'error', text: describeError(error) })
+    } finally {
+      setTestBusy(false)
+    }
+  }
+
+  if (!config) {
+    return (
+      <div>
+        <SettingsPageHeader title={t('peakRouting.title')} description={t('peakRouting.description')} />
+        {message ? <p className="mt-4 text-sm text-[var(--color-error)]">{message.text}</p> : null}
+      </div>
+    )
+  }
+
+  return (
+    <div>
+      <SettingsPageHeader
+        title={t('peakRouting.title')}
+        description={t('peakRouting.description')}
+        action={(
+          <>
+            <Button variant="secondary" size="base" icon={<RefreshCw size={14} />} onClick={() => void load()}>
+              {t('peakRouting.reload')}
+            </Button>
+            <Button variant="primary" size="base" icon={<Save size={14} />} loading={saving} onClick={() => void save()}>
+              {saving ? t('peakRouting.saving') : t('peakRouting.save')}
+            </Button>
+          </>
+        )}
+      />
+
+      {message ? (
+        <p className={`mt-4 text-sm ${message.tone === 'ok' ? 'text-[var(--color-text-secondary)]' : 'text-[var(--color-error)]'}`}>
+          {message.text}
+        </p>
+      ) : null}
+
+      <SettingsSection title={t('peakRouting.status.title')}>
+        <SettingsGroup>
+          <SettingsRow title={t('peakRouting.status.window')}>
+            <span className="text-sm text-[var(--color-text-secondary)]">
+              {status
+                ? status.inPeakWindow
+                  ? t('peakRouting.status.peak')
+                  : t('peakRouting.status.offPeak')
+                : '—'}
+            </span>
+          </SettingsRow>
+          <SettingsRow title={t('peakRouting.status.next')}>
+            <span className="text-sm tabular-nums text-[var(--color-text-secondary)]">
+              {status?.windowEnd
+                ? `${t('peakRouting.status.endsAt')} ${formatTime(status.windowEnd)}`
+                : status?.nextWindowStart
+                  ? formatDateTime(status.nextWindowStart)
+                  : '—'}
+            </span>
+          </SettingsRow>
+          <SettingsRow title={t('peakRouting.status.classifier')}>
+            <span className="text-sm text-[var(--color-text-secondary)]">
+              {status?.classifier.lastDegradedReason
+                ? t('peakRouting.status.classifierDegraded', { reason: status.classifier.lastDegradedReason })
+                : status?.classifier.ready
+                  ? t('peakRouting.status.classifierReady')
+                  : t('peakRouting.status.classifierOff')}
+            </span>
+          </SettingsRow>
+          <SettingsSwitchRow
+            title={t('peakRouting.enabled.title')}
+            description={t('peakRouting.enabled.description')}
+            checked={config.enabled}
+            onChange={enabled => setConfig(current => current ? { ...current, enabled } : current)}
+          />
+        </SettingsGroup>
+      </SettingsSection>
+
+      <SettingsSection
+        title={t('peakRouting.routes.title')}
+        description={t('peakRouting.takeover.description')}
+      >
+        <div className="grid gap-3">
+          {ROUTE_KINDS.map(route => {
+            const selection = config[route.key]
+            const models = modelsForProvider(providers, selection.providerId)
+            const model = findModel(providers, selection.providerId, selection.modelId)
+            return (
+              <SettingsGroup key={route.key}>
+                <SettingsBlock>
+                  <div className="mb-3">
+                    <div className="text-[13px] font-semibold text-[var(--color-text-primary)]">{t(route.labelKey)}</div>
+                    <div className="mt-0.5 text-xs text-[var(--color-text-tertiary)]">{t(route.hintKey)}</div>
+                  </div>
+                  <div className="grid gap-3 sm:grid-cols-3">
+                    <SelectField
+                      label={t('peakRouting.route.provider')}
+                      value={selection.providerId ?? ''}
+                      options={providerOptions}
+                      onChange={value => onProviderChange(route.key, value)}
+                    />
+                    <SelectField
+                      label={t('peakRouting.route.model')}
+                      value={selection.modelId}
+                      options={modelOptions(models, selection.modelId, t('peakRouting.route.unavailable'))}
+                      onChange={value => onModelChange(route.key, value)}
+                    />
+                    <SelectField
+                      label={t('peakRouting.route.effort')}
+                      value={selection.effortLevel}
+                      options={effortOptions(model)}
+                      onChange={value => updateRoute(route.key, { effortLevel: value as ModelReasoningEffort })}
+                    />
+                  </div>
+                </SettingsBlock>
+              </SettingsGroup>
+            )
+          })}
+        </div>
+      </SettingsSection>
+
+      <SettingsSection title={t('peakRouting.classifier.title')} description={t('peakRouting.classifier.description')}>
+        <SettingsGroup>
+          <SettingsSwitchRow
+            title={t('peakRouting.classifier.enabled')}
+            checked={config.classifier.enabled}
+            onChange={enabled => updateClassifier({ enabled })}
+          />
+          <SettingsBlock>
+            <div className="grid gap-3 sm:grid-cols-2">
+              <SelectField
+                label={t('peakRouting.route.provider')}
+                value={config.classifier.providerId ?? ''}
+                options={providerOptions}
+                onChange={onClassifierProviderChange}
+              />
+              <SelectField
+                label={t('peakRouting.route.model')}
+                value={config.classifier.modelId}
+                options={modelOptions(
+                  modelsForProvider(providers, config.classifier.providerId),
+                  config.classifier.modelId,
+                  t('peakRouting.route.unavailable'),
+                )}
+                onChange={modelId => updateClassifier({ modelId })}
+              />
+              <Input
+                label={t('peakRouting.classifier.timeout')}
+                type="number"
+                min={500}
+                max={15000}
+                step={100}
+                value={config.classifier.timeoutMs}
+                onChange={event => updateClassifier({ timeoutMs: Number(event.target.value) })}
+              />
+              <Input
+                label={t('peakRouting.classifier.sticky')}
+                type="number"
+                min={1}
+                max={240}
+                value={config.classifier.stickyMinutes}
+                onChange={event => updateClassifier({ stickyMinutes: Number(event.target.value) })}
+              />
+              <Input
+                label={t('peakRouting.classifier.minConfidence')}
+                type="number"
+                min={0}
+                max={1}
+                step={0.05}
+                value={config.classifier.minConfidence}
+                onChange={event => updateClassifier({ minConfidence: Number(event.target.value) })}
+              />
+              <Input
+                label={t('peakRouting.classifier.maxInput')}
+                type="number"
+                min={200}
+                max={8000}
+                step={100}
+                value={config.classifier.maxInputChars}
+                onChange={event => updateClassifier({ maxInputChars: Number(event.target.value) })}
+              />
+            </div>
+          </SettingsBlock>
+          <SettingsBlock>
+            <TextArea
+              label={t('peakRouting.classifier.testPlaceholder')}
+              rows={3}
+              value={testText}
+              onChange={event => setTestText(event.target.value)}
+            />
+            <div className="mt-2 flex flex-wrap items-center gap-2">
+              <Button
+                variant="secondary"
+                size="base"
+                icon={<FlaskConical size={14} />}
+                loading={testBusy}
+                disabled={!testText.trim()}
+                onClick={() => void runClassifierTest()}
+              >
+                {t('peakRouting.classifier.test')}
+              </Button>
+              {testVerdict ? (
+                <span className="text-xs text-[var(--color-text-secondary)]">
+                  {testVerdict.hit ? t('peakRouting.classifier.hit') : t('peakRouting.classifier.miss')}
+                  {' · '}
+                  {testVerdict.confidence.toFixed(2)}
+                  {' · '}
+                  {testVerdict.latencyMs}ms
+                  {testVerdict.degraded ? ` · ${testVerdict.degraded}` : ''}
+                </span>
+              ) : null}
+            </div>
+          </SettingsBlock>
+        </SettingsGroup>
+      </SettingsSection>
+
+      <SettingsSection title={t('peakRouting.windows.title')} description={t('peakRouting.windows.description')}>
+        <SettingsGroup>
+          <SettingsBlock>
+            <ul className="space-y-1 text-sm text-[var(--color-text-secondary)]">
+              {config.peakWindows.map((window, index) => (
+                <li key={`${window.start}-${window.end}-${index}`}>{formatPeakWindow(window)}</li>
+              ))}
+            </ul>
+          </SettingsBlock>
+          <SettingsBlock>
+            <TextArea
+              label={t('peakRouting.holidays.title')}
+              hint={t('peakRouting.holidays.description')}
+              error={holidaysError ?? undefined}
+              rows={6}
+              value={holidaysText}
+              onChange={event => {
+                setHolidaysText(event.target.value)
+                setHolidaysError(null)
+              }}
+            />
+          </SettingsBlock>
+        </SettingsGroup>
+      </SettingsSection>
+    </div>
+  )
+}
+
+function modelsForProvider(providers: PeakRoutingCatalog['providers'], providerId: string | null): PeakRoutingCatalogModel[] {
+  if (!providerId) return []
+  return providers.find(provider => provider.providerId === providerId)?.models ?? []
+}
+
+function findModel(providers: PeakRoutingCatalog['providers'], providerId: string | null, modelId: string): PeakRoutingCatalogModel | undefined {
+  return modelsForProvider(providers, providerId).find(model => model.modelId === modelId)
+}
+
+function firstModel(providers: PeakRoutingCatalog['providers'], providerId: string): PeakRoutingCatalogModel | undefined {
+  return modelsForProvider(providers, providerId)[0]
+}
+
+function defaultEffort(model: PeakRoutingCatalogModel | undefined, fallback: ModelReasoningEffort): ModelReasoningEffort {
+  if (model?.defaultEffort && MODEL_REASONING_EFFORTS.includes(model.defaultEffort as ModelReasoningEffort)) {
+    return model.defaultEffort as ModelReasoningEffort
+  }
+  const supported = model?.supportedEfforts.find(effort => MODEL_REASONING_EFFORTS.includes(effort as ModelReasoningEffort))
+  return (supported as ModelReasoningEffort | undefined) ?? fallback
+}
+
+function effortOptions(model: PeakRoutingCatalogModel | undefined) {
+  const supported = model?.supportedEfforts?.length
+    ? model.supportedEfforts.filter(effort => MODEL_REASONING_EFFORTS.includes(effort as ModelReasoningEffort))
+    : [...MODEL_REASONING_EFFORTS]
+  return supported.map(effort => ({ value: effort, label: effort }))
+}
+
+function modelOptions(models: PeakRoutingCatalogModel[], current: string, unavailableLabel: string) {
+  const options = models.map(model => ({ value: model.modelId, label: model.modelName }))
+  if (current && !options.some(option => option.value === current)) {
+    options.push({ value: current, label: `${current} (${unavailableLabel})` })
+  }
+  return options
+}
+
+function parseHolidays(text: string): { dates: string[]; invalid: string[] } {
+  const tokens = text.split(/[\s,]+/).map(token => token.trim()).filter(Boolean)
+  const invalid = tokens.filter(token => !isValidDateOnly(token))
+  return { dates: [...new Set(tokens)].sort(), invalid }
+}
+
+function formatTime(value: string): string {
+  const date = new Date(value)
+  return Number.isNaN(date.getTime())
+    ? value
+    : date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
+}
+
+function formatDateTime(value: string): string {
+  const date = new Date(value)
+  return Number.isNaN(date.getTime()) ? value : date.toLocaleString()
+}
+
+function describeError(error: unknown): string {
+  return error instanceof Error ? error.message : String(error)
+}
