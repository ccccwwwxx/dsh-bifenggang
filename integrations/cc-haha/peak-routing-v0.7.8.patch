+import { createHash, randomBytes } from 'node:crypto'
+import * as fs from 'node:fs/promises'
+import os from 'node:os'
+import path from 'node:path'
+
+import { ApiError } from '../middleware/errorHandler.js'
+import type { SavedProvider } from '../types/provider.js'
+import type { SessionModelOption } from '../../shared/sessionDelegation.js'
+import {
+  PEAK_ROUTING_TIMEZONE,
+  defaultPeakRoutingConfig,
+  getPeakWindowStatus,
+  normalizePeakRoutingConfig,
+  type PeakRoutingConfig,
+  type PeakRoutingSelection,
+} from '../../shared/peakRouting.js'
+import { listSessionModels } from './sessionModelCatalog.js'
+import { ProviderService } from './providerService.js'
+import { providerTextCompletion, type ProviderTextCompletionResult } from './providerTextCompletion.js'
+
+const CONFIG_FILE_NAME = 'peak-routing.json'
+const LOG_FILE_NAME = 'peak-routing.log'
+const LOG_MAX_BYTES = 5 * 1024 * 1024
+const CLASSIFIER_CACHE_TTL_MS = 10 * 60_000
+const CLASSIFIER_CACHE_MAX = 256
+const FAILURE_LOG_INTERVAL_MS = 60_000
+const STICKY_SWEEP_MS = 24 * 60 * 60 * 1000
+
+export type PeakRoutingDecisionSource =
+  | 'default'
+  | 'peak-window'
+  | 'classifier-hit'
+  | 'classifier-sticky'
+
+export type PeakRoutingDecision = {
+  source: PeakRoutingDecisionSource
+  selection: PeakRoutingSelection
+  stickyUntil?: number
+  classifier?: ClassifierVerdict
+}
+
+export type ClassifierVerdict = {
+  hit: boolean
+  confidence: number
+  reason: string
+  latencyMs: number
+  degraded?: string
+}
+
+export type PeakRoutingStatus = {
+  now: string
+  revision: string
+  exists: boolean
+  enabled: boolean
+  inPeakWindow: boolean
+  isHoliday: boolean
+  windowEnd: string | null
