+import { afterEach, beforeEach, expect, test } from 'bun:test'
+import * as fs from 'node:fs/promises'
+import os from 'node:os'
+import path from 'node:path'
+
+import { handlePeakRoutingApi } from '../api/peak-routing.js'
+import { peakRoutingService } from '../services/peakRoutingService.js'
+import { defaultPeakRoutingConfig } from '../../shared/peakRouting.js'
+
+const originalConfigDir = process.env.CLAUDE_CONFIG_DIR
+let configDir = ''
+let revision = '0'
+
+const providersFixture = {
+  schemaVersion: 3,
+  activeId: 'test-provider',
+  providers: [{
+    id: 'test-provider',
+    presetId: 'deepseek',
+    name: 'DeepSeek Test',
+    apiKey: 'test-key',
+    baseUrl: 'https://api.deepseek.com/anthropic',
+    apiFormat: 'anthropic',
+    runtimeKind: 'anthropic_compatible',
+    models: {
+      main: 'deepseek-v4-flash',
+      haiku: 'deepseek-v4-flash',
+      sonnet: 'deepseek-v4-pro',
+      opus: 'deepseek-v4-pro',
+    },
+  }],
+}
+
+function fullConfig(enabled: boolean) {
+  return {
+    ...defaultPeakRoutingConfig(),
+    enabled,
+    defaultRoute: { providerId: 'test-provider', modelId: 'deepseek-v4-flash', effortLevel: 'medium' as const },
+    peakRoute: { providerId: 'test-provider', modelId: 'deepseek-v4-pro', effortLevel: 'low' as const },
+    abstractRoute: { providerId: 'test-provider', modelId: 'deepseek-v4-pro', effortLevel: 'xhigh' as const },
+    classifier: {
+      ...defaultPeakRoutingConfig().classifier,
+      providerId: 'test-provider',
+      modelId: 'deepseek-v4-flash',
+    },
+  }
+}
+
+async function patch(body: unknown): Promise<{ status: number; json: any }> {
+  const url = new URL('http://127.0.0.1:3456/api/peak-routing')
+  const response = await handlePeakRoutingApi(new Request(url, {
+    method: 'PATCH',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body),
+  }), url, ['api', 'peak-routing'])
+  return { status: response.status, json: await response.json() }
+}
+
+beforeEach(async () => {
+  configDir = await fs.mkdtemp(path.join(os.tmpdir(), 'peak-api-'))
+  process.env.CLAUDE_CONFIG_DIR = configDir
+  await fs.mkdir(path.join(configDir, 'cc-haha'), { recursive: true })
+  await fs.writeFile(path.join(configDir, 'cc-haha', 'providers.json'), JSON.stringify(providersFixture))
+  peakRoutingService.__resetForTests()
+  const saved = await peakRoutingService.saveConfig(fullConfig(true))
+  revision = saved.revision
+})
+
+afterEach(async () => {
+  peakRoutingService.__resetForTests()
+  if (originalConfigDir === undefined) delete process.env.CLAUDE_CONFIG_DIR
+  else process.env.CLAUDE_CONFIG_DIR = originalConfigDir
+  await fs.rm(configDir, { recursive: true, force: true })
+})
+
+test('PATCH toggles enabled without touching the routes', async () => {
+  const result = await patch({ enabled: false, expectedRevision: revision })
+  expect(result.status).toBe(200)
+  expect(result.json).toMatchObject({ ok: true, enabled: false })
+  const current = await peakRoutingService.getConfig()
+  expect(current.config.enabled).toBe(false)
+  expect(current.config.peakRoute).toEqual(fullConfig(true).peakRoute)
+})
+
+test('PATCH rejects unknown fields and non-boolean values', async () => {
+  expect((await patch({ enabled: true, peakRoute: {} })).status).toBe(400)
+  expect((await patch({ enabled: 'yes' })).status).toBe(400)
+})
+
+test('PATCH returns 409 for a stale revision', async () => {
+  const result = await patch({ enabled: false, expectedRevision: 'stale' })
+  expect(result.status).toBe(409)
+})
