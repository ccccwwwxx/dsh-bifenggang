index 0000000..6c902f9
--- /dev/null
+++ b/src/server/api/peak-routing.ts
@@ -0,0 +1,125 @@
+/**
+ * Peak/off-peak model routing REST API.
+ *
+ * GET   /api/peak-routing                 — effective config + revision
+ * GET   /api/peak-routing/status          — current peak window and classifier health
+ * GET   /api/peak-routing/catalog         — providers, models and supported efforts
+ * PUT   /api/peak-routing                 — save config (optional expectedRevision)
+ * PATCH /api/peak-routing                 — enabled-only phone toggle
+ * POST  /api/peak-routing/classify-test   — run the classifier once without routing
+ */
+
+import { ApiError, errorResponse } from '../middleware/errorHandler.js'
+import { peakRoutingService } from '../services/peakRoutingService.js'
+
+const CLASSIFY_TEST_BODY_LIMIT = 64 * 1024
+const CLASSIFY_TEST_TEXT_LIMIT = 8000
+const CLASSIFY_TEST_PER_MINUTE = 20
+
+let classifyTestWindow = { start: 0, count: 0 }
+
+export async function handlePeakRoutingApi(
+  req: Request,
+  url: URL,
+  segments: string[],
+): Promise<Response> {
+  void url
+  try {
+    const sub = segments[2]
+
+    if (sub === undefined) {
+      if (req.method === 'GET') {
+        const result = await peakRoutingService.getConfig()
+        return noStore(Response.json(result))
+      }
+      if (req.method === 'PUT') {
+        const body = await parseJsonBody(req)
+        const expectedRevision = typeof body.expectedRevision === 'string'
+          ? body.expectedRevision
+          : undefined
+        const saved = await peakRoutingService.saveConfig(body.config, expectedRevision)
+        return noStore(Response.json({ ok: true, ...saved }))
+      }
+      if (req.method === 'PATCH') {
+        // The phone owns only the master switch. Refuse anything that could
+        // rewrite a route the desktop just saved.
+        const body = await parseJsonBody(req)
+        if (Object.keys(body).some(key => key !== 'enabled' && key !== 'expectedRevision')) {
+          throw ApiError.badRequest('enabled and expectedRevision only')
+        }
+        if (typeof body.enabled !== 'boolean') {
+          throw ApiError.badRequest('enabled must be a boolean')
+        }
+        const expectedRevision = typeof body.expectedRevision === 'string'
+          ? body.expectedRevision
+          : undefined
+        const saved = await peakRoutingService.setEnabled(body.enabled, expectedRevision)
+        return noStore(Response.json({
+          ok: true,
+          enabled: saved.config.enabled,
+          revision: saved.revision,
+        }))
+      }
+      throw methodNotAllowed(req.method)
+    }
+
+    if (sub === 'status') {
+      if (req.method !== 'GET') throw methodNotAllowed(req.method)
+      return noStore(Response.json(await peakRoutingService.getStatus()))
+    }
+
+    if (sub === 'catalog') {
+      if (req.method !== 'GET') throw methodNotAllowed(req.method)
+      return noStore(Response.json(await peakRoutingService.getCatalog()))
+    }
+
+    if (sub === 'classify-test') {
+      if (req.method !== 'POST') throw methodNotAllowed(req.method)
+      if (!claimClassifyTestSlot()) {
+        throw new ApiError(429, 'Too many classifier tests; wait a minute', 'RATE_LIMITED')
+      }
+      const body = await parseJsonBody(req)
+      const text = typeof body.text === 'string' ? body.text.slice(0, CLASSIFY_TEST_TEXT_LIMIT) : ''
+      if (!text.trim()) throw ApiError.badRequest('text is required')
+      return noStore(Response.json({ ok: true, verdict: await peakRoutingService.classifyForTest(text) }))
+    }
+
+    throw ApiError.notFound(`Unknown peak routing endpoint: ${sub}`)
+  } catch (error) {
+    return errorResponse(error)
+  }
+}
+
+function claimClassifyTestSlot(now = Date.now()): boolean {
+  if (now - classifyTestWindow.start >= 60_000) {
+    classifyTestWindow = { start: now, count: 1 }
+    return true
+  }
+  classifyTestWindow.count += 1
+  return classifyTestWindow.count <= CLASSIFY_TEST_PER_MINUTE
+}
+
+async function parseJsonBody(req: Request): Promise<Record<string, unknown>> {
+  const raw = await req.text()
+  if (raw.length > CLASSIFY_TEST_BODY_LIMIT) throw new ApiError(413, 'Request body is too large', 'PAYLOAD_TOO_LARGE')
+  if (!raw.trim()) return {}
+  try {
+    const parsed: unknown = JSON.parse(raw)
+    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+      throw ApiError.badRequest('Object body required')
+    }
+    return parsed as Record<string, unknown>
+  } catch (error) {
+    if (error instanceof ApiError) throw error
+    throw ApiError.badRequest('Invalid JSON body')
+  }
+}
+
+function methodNotAllowed(method: string): ApiError {
+  return new ApiError(405, `Method ${method} not allowed`, 'METHOD_NOT_ALLOWED')
+}
+
+function noStore(response: Response): Response {
+  response.headers.set('Cache-Control', 'no-store')
+  return response
+}
