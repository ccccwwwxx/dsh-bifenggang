+test('headline reflects disabled, peak, off-peak and holiday states', () => {
+  expect(peakStatusHeadline(null)).toBe('读取中…')
+  expect(peakStatusHeadline(status({ enabled: false }))).toBe('已关闭')
+  expect(peakStatusHeadline(status())).toBe('峰时')
+  expect(peakStatusHeadline(status({ inPeakWindow: false, windowEnd: null }))).toBe('谷时')
+  expect(peakStatusHeadline(status({ isHoliday: true }))).toBe('节假日 · 谷时')
+})
+
+test('next-switch text explains the current window or the next peak', () => {
