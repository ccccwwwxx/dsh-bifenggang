@@ -0,0 +1,52 @@
+export type PeakRoutingStatus = {
+  now: string
+  revision: string
+  exists: boolean
+  enabled: boolean
+  inPeakWindow: boolean
+  isHoliday: boolean
+  windowEnd: string | null
+  nextWindowStart: string | null
+  classifier: {
+    ready: boolean
+    lastLatencyMs: number | null
+    lastDegradedReason: string | null
+  }
+}
+
+export function peakStatusHeadline(status: PeakRoutingStatus | null): string {
+  if (!status) return '读取中…'
+  if (!status.enabled) return '已关闭'
+  if (status.isHoliday) return '节假日 · 谷时'
+  return status.inPeakWindow ? '峰时' : '谷时'
+}
+
+export function peakNextSwitchText(status: PeakRoutingStatus | null): string {
+  if (!status || !status.enabled) return ''
+  if (status.windowEnd) return `本时段 ${clock(status.windowEnd)} 结束`
+  if (status.nextWindowStart) return `下次峰时 ${dayClock(status.nextWindowStart)}`
+  return ''
+}
+
+export function peakClassifierText(status: PeakRoutingStatus | null): string {
+  if (!status) return ''
+  if (status.classifier.lastDegradedReason) return '分类器降级'
+  if (status.classifier.ready) return '分类器就绪'
+  return '分类器关闭'
+}
+
+function clock(value: string): string {
+  const date = new Date(value)
+  if (Number.isNaN(date.getTime())) return value
+  return `${pad(date.getHours())}:${pad(date.getMinutes())}`
+}
+
+function dayClock(value: string): string {
+  const date = new Date(value)
+  if (Number.isNaN(date.getTime())) return value
+  return `${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`
+}
+
+function pad(value: number): string {
+  return String(value).padStart(2, '0')
+}
