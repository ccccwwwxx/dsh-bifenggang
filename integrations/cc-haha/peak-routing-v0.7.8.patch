diff --git a/desktop/src/api/peakRouting.ts b/desktop/src/api/peakRouting.ts
new file mode 100644
index 0000000..184c2a2
--- /dev/null
+++ b/desktop/src/api/peakRouting.ts
@@ -0,0 +1,68 @@
+import { api } from './client'
+import type { PeakRoutingConfig } from '../../../src/shared/peakRouting'
+
+export type PeakRoutingStatus = {
+  now: string
+  revision: string
+  exists: boolean
+  enabled: boolean
+  inPeakWindow: boolean
+  isHoliday: boolean
+  windowEnd: string | null
+  nextWindowStart: string | null
+  classifier: {
+    ready: boolean
+    lastLatencyMs: number | null
+    lastDegradedReason: string | null
+  }
+}
+
+export type PeakRoutingCatalogModel = {
+  modelId: string
+  modelName: string
+  supportedEfforts: string[]
+  defaultEffort?: string
+}
+
+export type PeakRoutingCatalogProvider = {
+  providerId: string
+  providerName: string
+  models: PeakRoutingCatalogModel[]
+}
+
+export type PeakRoutingCatalog = {
+  providers: PeakRoutingCatalogProvider[]
+}
+
+export type PeakRoutingVerdict = {
+  hit: boolean
+  confidence: number
+  reason: string
+  latencyMs: number
+  degraded?: string
+}
+
+export const peakRoutingApi = {
+  get() {
+    return api.get<{ config: PeakRoutingConfig; revision: string; exists: boolean }>('/api/peak-routing')
+  },
+
+  status() {
+    return api.get<PeakRoutingStatus>('/api/peak-routing/status')
+  },
+
+  catalog() {
+    return api.get<PeakRoutingCatalog>('/api/peak-routing/catalog')
+  },
+
+  update(config: PeakRoutingConfig, expectedRevision?: string) {
+    return api.put<{ ok: true; config: PeakRoutingConfig; revision: string }>('/api/peak-routing', {
+      config,
+      ...(expectedRevision !== undefined ? { expectedRevision } : {}),
+    })
+  },
+
+  classifyTest(text: string) {
+    return api.post<{ ok: true; verdict: PeakRoutingVerdict }>('/api/peak-routing/classify-test', { text })
+  },
+}
