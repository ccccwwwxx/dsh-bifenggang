+import { afterEach, beforeEach, expect, test } from 'bun:test'
+import * as fs from 'node:fs/promises'
+import os from 'node:os'
+import path from 'node:path'
+
+import { PeakRoutingService } from './peakRoutingService.js'
+import { defaultPeakRoutingConfig } from '../../shared/peakRouting.js'
+
+const originalConfigDir = process.env.CLAUDE_CONFIG_DIR
+let configDir = ''
+let service: PeakRoutingService
+
+const providersFixture = {
+  schemaVersion: 3,
+  activeId: 'test-provider',
+  providers: [{
+    id: 'test-provider',
+    presetId: 'deepseek',
+    name: 'DeepSeek Test',
+    apiKey: 'test-key',
+    baseUrl: 'https://api.deepseek.com/anthropic',
+    apiFormat: 'anthropic',
+    runtimeKind: 'anthropic_compatible',
+    models: {
+      main: 'deepseek-v4-flash',
+      haiku: 'deepseek-v4-flash',
+      sonnet: 'deepseek-v4-pro',
+      opus: 'deepseek-v4-pro',
+    },
+  }],
+}
+
+function remoteConfig(overrides: Partial<ReturnType<typeof defaultPeakRoutingConfig>> = {}) {
+  return {
+    ...defaultPeakRoutingConfig(),
+    enabled: true,
+    defaultRoute: { providerId: 'test-provider', modelId: 'deepseek-v4-flash', effortLevel: 'medium' as const },
+    peakRoute: { providerId: 'test-provider', modelId: 'deepseek-v4-pro', effortLevel: 'low' as const },
+    abstractRoute: { providerId: 'test-provider', modelId: 'deepseek-v4-pro', effortLevel: 'xhigh' as const },
+    classifier: {
+      ...defaultPeakRoutingConfig().classifier,
+      providerId: 'test-provider',
+      modelId: 'deepseek-v4-flash',
+    },
+    ...overrides,
+  }
+}
+
+beforeEach(async () => {
+  configDir = await fs.mkdtemp(path.join(os.tmpdir(), 'peak-routing-'))
+  process.env.CLAUDE_CONFIG_DIR = configDir
+  await fs.mkdir(path.join(configDir, 'cc-haha'), { recursive: true })
+  await fs.writeFile(path.join(configDir, 'cc-haha', 'providers.json'), JSON.stringify(providersFixture))
+  service = new PeakRoutingService()
+  service.__resetForTests()
+})
+
+afterEach(async () => {
+  service.__resetForTests()
+  if (originalConfigDir === undefined) delete process.env.CLAUDE_CONFIG_DIR
+  else process.env.CLAUDE_CONFIG_DIR = originalConfigDir
+  await fs.rm(configDir, { recursive: true, force: true })
+})
+
+test('resolves the saved DeepSeek flash model as the default route', async () => {
+  const { config, exists } = await service.getConfig()
+  expect(exists).toBe(false)
+  expect(config.defaultRoute).toEqual({
+    providerId: 'test-provider',
+    modelId: 'deepseek-v4-flash',
+    effortLevel: 'medium',
+  })
+  expect(config.classifier.providerId).toBe('test-provider')
+  expect(config.classifier.modelId).toBe('deepseek-v4-flash')
+})
+
+test('saves with a revision and rejects a stale revision', async () => {
+  const first = await service.getConfig()
+  const saved = await service.saveConfig(remoteConfig(), first.revision)
+  expect(saved.revision).not.toBe(first.revision)
+  await expect(service.saveConfig(remoteConfig(), first.revision)).rejects.toMatchObject({
+    statusCode: 409,
+  })
+})
+
+test('setEnabled changes only the switch and preserves the routes', async () => {
+  const first = await service.getConfig()
+  const saved = await service.saveConfig(remoteConfig(), first.revision)
+  const toggled = await service.setEnabled(false, saved.revision)
+  expect(toggled.config.enabled).toBe(false)
+  expect(toggled.config.defaultRoute).toEqual(remoteConfig().defaultRoute)
+  expect(toggled.config.peakRoute).toEqual(remoteConfig().peakRoute)
+  expect(toggled.config.abstractRoute).toEqual(remoteConfig().abstractRoute)
+  expect(toggled.config.classifier).toEqual(remoteConfig().classifier)
+
+  await expect(service.setEnabled(true, saved.revision)).rejects.toMatchObject({ statusCode: 409 })
+})
+
+test('turning the router off still works after a configured provider disappears', async () => {
+  const first = await service.getConfig()
+  await service.saveConfig(remoteConfig(), first.revision)
+  await fs.writeFile(path.join(configDir, 'cc-haha', 'providers.json'), JSON.stringify({
+    schemaVersion: 3,
+    activeId: null,
+    providers: [],
+  }))
+
+  const off = await service.setEnabled(false)
+  expect(off.config.enabled).toBe(false)
+  await expect(service.setEnabled(true)).rejects.toMatchObject({ statusCode: 400 })
+})
+
+test('rejects a model/effort combination the catalog does not support', async () => {
+  const first = await service.getConfig()
+  await expect(service.saveConfig(remoteConfig({
+    peakRoute: { providerId: 'test-provider', modelId: 'deepseek-v4-pro', effortLevel: 'low' as const },
+    abstractRoute: { providerId: 'test-provider', modelId: 'missing-model', effortLevel: 'xhigh' as const },
+  }), first.revision)).rejects.toMatchObject({ statusCode: 400 })
+})
+
+test('peak window selects the peak route when the classifier declines', async () => {
+  const first = await service.getConfig()
+  await service.saveConfig(remoteConfig(), first.revision)
+  service.__setClockForTests(() => new Date('2026-11-16T02:00:00Z')) // Monday 10:00 Beijing
+  service.__setCompletionForTests(async () => ({
+    ok: true,
+    text: '{"highAbstraction":false,"confidence":0.9,"reason":"small edit"}',
+  }))
+  const decision = await service.decideForTurn('session-1', '请把这一行日志的拼写改一下')
+  expect(decision).toMatchObject({
+    source: 'peak-window',
+    selection: { providerId: 'test-provider', modelId: 'deepseek-v4-pro', effortLevel: 'low' },
+  })
+})
+
+test('a classified-high request sticks to the abstract route', async () => {
+  const first = await service.getConfig()
+  await service.saveConfig(remoteConfig(), first.revision)
+  service.__setClockForTests(() => new Date('2026-11-16T02:00:00Z'))
+  service.__setCompletionForTests(async () => ({
+    ok: true,
+    text: '{"highAbstraction":true,"confidence":0.92,"reason":"multi-file redesign"}',
+  }))
+
+  const hit = await service.decideForTurn('session-2', '请重新设计整个模块的抽象层，并拆成多个文件')
+  expect(hit).toMatchObject({
+    source: 'classifier-hit',
+    selection: { providerId: 'test-provider', modelId: 'deepseek-v4-pro', effortLevel: 'xhigh' },
+  })
+
+  service.__setCompletionForTests(async () => {
+    throw new Error('the classifier must not run while sticky')
+  })
+  const sticky = await service.decideForTurn('session-2', '继续')
+  expect(sticky?.source).toBe('classifier-sticky')
+})
+
+test('classifier failure falls back to the window route without throwing', async () => {
+  const first = await service.getConfig()
+  await service.saveConfig(remoteConfig(), first.revision)
+  service.__setClockForTests(() => new Date('2026-11-16T02:00:00Z'))
+  service.__setCompletionForTests(async () => ({
+    ok: false,
+    reason: 'timeout',
+    message: 'The model did not answer in time',
+  }))
+  const decision = await service.decideForTurn('session-3', '请分析一下这个模块的整体架构和依赖关系')
+  expect(decision).toMatchObject({ source: 'peak-window' })
+  expect(decision?.classifier?.degraded).toContain('timeout')
+})
+
+test('off-peak requests use the default route', async () => {
+  const first = await service.getConfig()
+  await service.saveConfig(remoteConfig(), first.revision)
+  service.__setClockForTests(() => new Date('2026-11-16T13:00:00Z')) // Monday 21:00 Beijing
+  service.__setCompletionForTests(async () => ({
+    ok: true,
+    text: '{"highAbstraction":false,"confidence":0.8,"reason":"simple"}',
+  }))
+  const decision = await service.decideForTurn('session-4', '把这段说明翻译成中文')
+  expect(decision).toMatchObject({
+    source: 'default',
+    selection: { providerId: 'test-provider', modelId: 'deepseek-v4-flash', effortLevel: 'medium' },
+  })
+})
+
+test('a disabled config never routes', async () => {
+  const first = await service.getConfig()
+  await service.saveConfig({ ...remoteConfig(), enabled: false }, first.revision)
+  expect(await service.decideForTurn('session-5', '设计一个复杂架构')).toBeNull()
+})
+
+test('corrupted config is quarantined and defaults are used', async () => {
+  await fs.writeFile(path.join(configDir, 'cc-haha', 'peak-routing.json'), '{not-json')
+  const { config, exists } = await service.getConfig()
+  expect(exists).toBe(false)
+  expect(config.defaultRoute.modelId).toBe('deepseek-v4-flash')
+  const entries = await fs.readdir(path.join(configDir, 'cc-haha'))
+  expect(entries.some(entry => entry.includes('.invalid-'))).toBe(true)
+})
