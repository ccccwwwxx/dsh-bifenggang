+import type { ApiClient } from '../../core/client'
+import { Footnote, Group, InlineError, ListRow, SectionHeader, Switch } from '../kit'
+import {
+  peakClassifierText,
+  peakNextSwitchText,
+  peakStatusHeadline,
+} from './peakRoutingModel'
+import { usePeakRouting } from './usePeakRouting'
+
+/**
+ * Phone-side peak routing: a status line and the global switch.
+ * The routes themselves are edited on the computer; exposing the full form
+ * here would let a stale phone overwrite a newer desktop configuration.
+ */
+export function PeakRoutingSection({ client }: { client: ApiClient | null }) {
+  const { status, error, busy, setEnabled } = usePeakRouting(client)
+  const classifier = peakClassifierText(status)
+  return (
+    <>
+      <SectionHeader title="避峰岗" />
+      <Group>
+        <ListRow
+          title="总开关"
+          subtitle={peakStatusHeadline(status)}
+          value={peakNextSwitchText(status)}
+          minHeight={58}
+          trailing={(
+            <Switch
+              label="避峰岗总开关"
+              value={status?.enabled === true}
+              onValueChange={(value) => void setEnabled(value)}
+              disabled={!status || busy}
+            />
+          )}
+        />
+      </Group>
+      <InlineError text={error ?? undefined} />
+      <Footnote>
+        手机关闭/开启的是这台电脑的全局避峰岗；路由模型请在电脑设置页修改。
+        {classifier ? ` · ${classifier}` : ''}
+      </Footnote>
+    </>
+  )
+}
