+  return !!a &&
+    a.providerId === b.providerId &&
+    a.modelId === b.modelId &&
+    a.effort === b.effort &&
+    (a.openAIFastMode ?? false) === (b.openAIFastMode ?? false)
+}
+
+/**
+ * Apply one peak-routing decision to a session's next turn.
+ *
+ * The caller runs before the user message reaches the CLI, so a cross-provider
+ * switch may restart this one session's process safely. Same-provider model
+ * changes stay in-process; a reasoning-effort change needs the restart because
+ * `--effort` is fixed at spawn.
+ *
+ * A turn already producing output, or background tasks still running, must not
+ * be interrupted: the override is persisted and deferred to the next idle turn.
+ */
+export async function applyPeakRoutingBeforeTurn(
+  ws: SessionConnection,
+  sessionId: string,
+  decision: PeakRoutingDecision,
+  options: { previousTurnInFlight: boolean },
+): Promise<{ applied: boolean; restarted: boolean; deferred: boolean }> {
+  let validated: SessionRuntimeSelection
+  try {
+    validated = await validateSessionRuntime({
+      providerId: decision.selection.providerId,
+      modelId: decision.selection.modelId,
+      effortLevel: decision.selection.effortLevel,
+      ...(decision.selection.openAIFastMode !== undefined
+        ? { openAIFastMode: decision.selection.openAIFastMode }
+        : {}),
+    })
+  } catch (error) {
+    console.warn(`[peak-routing] ignored unavailable route for ${sessionId}: ${error instanceof Error ? error.message : String(error)}`)
+    return { applied: false, restarted: false, deferred: false }
+  }
+
+  const normalized = await normalizeRuntimeOverrideInput({
+    providerId: validated.providerId,
+    modelId: validated.modelId,
+    effortLevel: validated.effortLevel,
+    ...(validated.openAIFastMode !== undefined
+      ? { openAIFastMode: validated.openAIFastMode }
+      : {}),
+  })
+  if (!normalized.ok) {
+    console.warn(`[peak-routing] ignored invalid ${normalized.reason} selection for ${sessionId}`)
+    return { applied: false, restarted: false, deferred: false }
+  }
+
+  const nextOverride = normalized.override
+  let restarted = false
+  let deferred = false
+
+  await enqueueRuntimeTransition(sessionId, async () => {
+    const previous = runtimeOverrides.get(sessionId)
+    const actual = conversationService.getSessionRuntimeSelection(sessionId)
+    const actualMatches = !!actual &&
+      actual.providerId === nextOverride.providerId &&
+      actual.modelId === nextOverride.modelId &&
+      (actual.effortLevel ?? undefined) === nextOverride.effort &&
+      (actual.openAIFastMode ?? false) === (nextOverride.openAIFastMode ?? false)
+
+    if (sameRuntimeOverride(previous, nextOverride) && (!conversationService.hasSession(sessionId) || actualMatches)) {
+      broadcastAppliedRuntimeConfig(sessionId)
+      return
+    }
+
+    runtimeOverrides.set(sessionId, nextOverride)
+    runtimeOverrideVersions.set(sessionId, (runtimeOverrideVersions.get(sessionId) ?? 0) + 1)
+    await persistSessionRuntimeConfig(sessionId, nextOverride)
+
+    if (!conversationService.hasSession(sessionId)) {
+      // A cold session starts with this override when the CLI is spawned.
+      broadcastAppliedRuntimeConfig(sessionId)
+      return
+    }
+
+    if (options.previousTurnInFlight || hasActiveBackgroundTasks(sessionId)) {
+      deferredRuntimeRestarts.set(sessionId, nextOverride)
+      deferred = true
+      broadcastAppliedRuntimeConfig(sessionId)
+      return
+    }
+
+    const sameProvider = actual?.providerId === nextOverride.providerId
+    const sameEffort = (actual?.effortLevel ?? undefined) === nextOverride.effort
+    const sameFast = (actual?.openAIFastMode ?? false) === (nextOverride.openAIFastMode ?? false)
+
+    if (sameProvider && sameEffort && sameFast) {
+      if (actual?.modelId === nextOverride.modelId) {
+        broadcastAppliedRuntimeConfig(sessionId)
+        return
+      }
+      const switched = await conversationService
+        .setModel(sessionId, nextOverride.modelId)
+        .catch(() => false)
+      if (switched) {
+        broadcastAppliedRuntimeConfig(sessionId)
+        console.log(`[peak-routing] ${sessionId} -> ${nextOverride.providerId ?? 'claude-official'}/${nextOverride.modelId} (${nextOverride.effort ?? 'default'}) in-process`)
+        return
+      }
+    }
+
+    restarted = await restartSessionWithRuntimeConfig(ws, sessionId)
+    if (restarted) {
+      console.log(`[peak-routing] ${sessionId} -> ${nextOverride.providerId ?? 'claude-official'}/${nextOverride.modelId} (${nextOverride.effort ?? 'default'}) restarted`)
+      return
+    }
+
+    // The process still runs the old provider. Do not leave an override that
+    // claims a switch that never happened.
+    if (previous) runtimeOverrides.set(sessionId, previous)
+    else runtimeOverrides.delete(sessionId)
+    broadcastAppliedRuntimeConfig(sessionId)
+  })
+
+  return { applied: true, restarted, deferred }
+}
+
 async function restartSessionWithRuntimeConfig(
   ws: SessionConnection,
   sessionId: string,
diff --git a/src/shared/peakRouting.test.ts b/src/shared/peakRouting.test.ts
new file mode 100644
index 0000000..434919c
--- /dev/null
+++ b/src/shared/peakRouting.test.ts
@@ -0,0 +1,122 @@
+import { expect, test } from 'bun:test'
+import {
+  DEFAULT_PEAK_WINDOWS,
+  PEAK_ROUTING_2026_HOLIDAYS,
+  defaultPeakRoutingConfig,
+  getPeakWindowStatus,
+  getShanghaiClock,
+  isValidDateOnly,
+  normalizeHolidayList,
+  normalizePeakRoutingConfig,
+} from './peakRouting.js'
+
+/** Beijing wall time → UTC Date, for readable cases. */
+function beijing(year: number, month: number, day: number, hour: number, minute = 0): Date {
+  return new Date(Date.UTC(year, month - 1, day, hour - 8, minute))
+}
+
+function configWith(overrides: Partial<ReturnType<typeof defaultPeakRoutingConfig>> = {}) {
+  return { ...defaultPeakRoutingConfig(), ...overrides }
+}
+
+test('maps Beijing wall time to the Asia/Shanghai clock', () => {
+  expect(getShanghaiClock(beijing(2026, 11, 16, 9, 0))).toEqual({
+    date: '2026-11-16',
+    weekday: 1,
+    minutes: 540,
+  })
+})
+
+test('peak windows are Monday–Friday 09:00–12:00 and 14:00–18:00, end-exclusive', () => {
+  const config = configWith()
+  const cases: Array<[string, Date, boolean]> = [
+    ['08:59 Monday', beijing(2026, 11, 16, 8, 59), false],
+    ['09:00 Monday', beijing(2026, 11, 16, 9, 0), true],
+    ['11:59 Monday', beijing(2026, 11, 16, 11, 59), true],
+    ['12:00 Monday', beijing(2026, 11, 16, 12, 0), false],
+    ['13:59 Monday', beijing(2026, 11, 16, 13, 59), false],
+    ['14:00 Monday', beijing(2026, 11, 16, 14, 0), true],
+    ['17:59 Monday', beijing(2026, 11, 16, 17, 59), true],
+    ['18:00 Monday', beijing(2026, 11, 16, 18, 0), false],
+    ['10:00 Saturday', beijing(2026, 11, 14, 10, 0), false],
+    ['10:00 Sunday', beijing(2026, 11, 15, 10, 0), false],
+  ]
+  for (const [label, now, expected] of cases) {
+    expect(getPeakWindowStatus(config, now).isPeak, label).toBe(expected)
+  }
+})
+
+test('statutory holidays are never peak, even on a weekday', () => {
+  const config = configWith({ holidays: ['2026-11-16'] })
+  const status = getPeakWindowStatus(config, beijing(2026, 11, 16, 10, 0))
+  expect(status).toMatchObject({ isPeak: false, isHoliday: true })
+})
+
+test('reports the current window end and the next window start', () => {
+  const config = configWith()
+  const inside = getPeakWindowStatus(config, beijing(2026, 11, 16, 10, 0))
+  expect(inside.windowEnd).toBe(beijing(2026, 11, 16, 12, 0).getTime())
+
+  const lunch = getPeakWindowStatus(config, beijing(2026, 11, 16, 12, 30))
+  expect(lunch.nextWindowStart).toBe(beijing(2026, 11, 16, 14, 0).getTime())
+
+  const fridayEvening = getPeakWindowStatus(config, beijing(2026, 11, 13, 18, 30))
+  expect(fridayEvening.nextWindowStart).toBe(beijing(2026, 11, 16, 9, 0).getTime())
+})
+
+test('the next window skips holidays', () => {
+  const config = configWith({ holidays: ['2026-11-16'] })
+  const fridayEvening = getPeakWindowStatus(config, beijing(2026, 11, 13, 18, 30))
+  expect(fridayEvening.nextWindowStart).toBe(beijing(2026, 11, 17, 9, 0).getTime())
+})
+
+test('holiday normalization keeps real ISO dates only', () => {
+  expect(normalizeHolidayList([
+    '2026-10-01', '2026-10-01', '2026-02-30', '2026-1-1', 'not-a-date', 42,
+  ])).toEqual(['2026-10-01'])
+  expect(isValidDateOnly('2026-02-30')).toBe(false)
+  expect(isValidDateOnly('2026-02-28')).toBe(true)
+})
+
+test('the default config uses the DeepSeek billing window and 2026 holidays', () => {
+  const config = defaultPeakRoutingConfig()
+  expect(config.peakWindows).toEqual(DEFAULT_PEAK_WINDOWS)
+  expect(config.holidays).toEqual(PEAK_ROUTING_2026_HOLIDAYS)
+  expect(config.timezone).toBe('Asia/Shanghai')
+  expect(config.enabled).toBe(false)
+})
+
+test('normalization clamps classifier values and rejects unusable windows', () => {
+  const base = defaultPeakRoutingConfig()
+  const normalized = normalizePeakRoutingConfig({
+    enabled: true,
+    defaultRoute: { providerId: 'p', modelId: 'flash', effortLevel: 'medium' },
+    peakRoute: { providerId: 'openai-official', modelId: 'gpt-6-luna', effortLevel: 'low' },
+    abstractRoute: { providerId: 'openai-official', modelId: 'gpt-6-astra', effortLevel: 'xhigh' },
+    classifier: { enabled: true, providerId: 'p', modelId: 'flash', timeoutMs: 99, stickyMinutes: 999, minConfidence: 3, maxInputChars: 10 },
+    holidays: ['2026-10-01'],
+  }, base)
+  expect(normalized.ok).toBe(true)
+  if (!normalized.ok) return
+  expect(normalized.config.classifier).toMatchObject({
+    timeoutMs: 500,
+    stickyMinutes: 240,
+    minConfidence: 1,
+    maxInputChars: 200,
+  })
+  expect(normalized.config.holidays).toEqual(['2026-10-01'])
+
+  const invalidWindow = normalizePeakRoutingConfig({
+    ...base,
+    peakWindows: [{ weekdays: [1], start: '12:00', end: '09:00' }],
+  }, base)
+  expect(invalidWindow.ok).toBe(false)
+})
+
+test('normalization requires model ids when enabled', () => {
+  const base = defaultPeakRoutingConfig()
+  const result = normalizePeakRoutingConfig({ ...base, enabled: true }, base)
+  expect(result.ok).toBe(false)
+  if (result.ok) return
+  expect(result.errors.join(' ')).toContain('modelId')
+})
diff --git a/src/shared/peakRouting.ts b/src/shared/peakRouting.ts
new file mode 100644
index 0000000..bf494f8
--- /dev/null
+++ b/src/shared/peakRouting.ts
@@ -0,0 +1,368 @@
+import { MODEL_REASONING_EFFORTS, type ModelReasoningEffort } from './modelReasoning.js'
+
+/**
+ * Peak/off-peak model routing ("避峰岗").
+ *
+ * DeepSeek bills weekdays (Beijing time, excluding statutory holidays) at
+ * 09:00–12:00 and 14:00–18:00 at the peak rate; everything else is off-peak.
+ * This module owns the shape, defaults and pure time-window math so the server
+ * router and the desktop settings pane agree on both.
+ */
+
+export const PEAK_ROUTING_SCHEMA_VERSION = 1
+export const PEAK_ROUTING_TIMEZONE = 'Asia/Shanghai' as const
+
+export type PeakRoutingSelection = {
+  providerId: string | null
+  modelId: string
+  effortLevel: ModelReasoningEffort
+  /** Only ChatGPT Official accepts this. */
+  openAIFastMode?: boolean
+}
+
+export type PeakRoutingWindow = {
+  /** ISO weekday numbers: Monday = 1 … Sunday = 7. */
+  weekdays: number[]
+  /** `HH:mm`, inclusive. */
+  start: string
+  /** `HH:mm`, exclusive. */
+  end: string
+}
+
+export type PeakRoutingClassifierConfig = {
+  enabled: boolean
+  providerId: string | null
+  modelId: string
+  /** Whole-call timeout for the classifier request. */
+  timeoutMs: number
+  /** How long a classified-high session keeps the abstract route. */
+  stickyMinutes: number
+  /** Minimum classifier confidence, 0–1. */
+  minConfidence: number
+  /** User text sent to the classifier is truncated to this many characters. */
+  maxInputChars: number
+}
+
+export type PeakRoutingConfig = {
+  schemaVersion: typeof PEAK_ROUTING_SCHEMA_VERSION
+  enabled: boolean
+  timezone: typeof PEAK_ROUTING_TIMEZONE
+  defaultRoute: PeakRoutingSelection
+  peakRoute: PeakRoutingSelection
+  abstractRoute: PeakRoutingSelection
+  classifier: PeakRoutingClassifierConfig
+  peakWindows: PeakRoutingWindow[]
+  /** `YYYY-MM-DD` dates that are statutory holidays (never peak). */
+  holidays: string[]
+  updatedAt?: string
+}
+
+/** The State Council's 2026 holiday arrangement (国办发明电〔2025〕7号). */
+export const PEAK_ROUTING_2026_HOLIDAYS: string[] = [
+  '2026-01-01', '2026-01-02', '2026-01-03',
+  '2026-02-15', '2026-02-16', '2026-02-17', '2026-02-18', '2026-02-19',
+  '2026-02-20', '2026-02-21', '2026-02-22', '2026-02-23',
+  '2026-04-04', '2026-04-05', '2026-04-06',
+  '2026-05-01', '2026-05-02', '2026-05-03', '2026-05-04', '2026-05-05',
+  '2026-06-19', '2026-06-20', '2026-06-21',
+  '2026-09-25', '2026-09-26', '2026-09-27',
+  '2026-10-01', '2026-10-02', '2026-10-03', '2026-10-04', '2026-10-05',
+  '2026-10-06', '2026-10-07',
+]
+
+export const DEFAULT_PEAK_WINDOWS: PeakRoutingWindow[] = [
+  { weekdays: [1, 2, 3, 4, 5], start: '09:00', end: '12:00' },
+  { weekdays: [1, 2, 3, 4, 5], start: '14:00', end: '18:00' },
+]
+
+export function defaultPeakRoutingConfig(): PeakRoutingConfig {
+  return {
+    schemaVersion: PEAK_ROUTING_SCHEMA_VERSION,
+    enabled: false,
+    timezone: PEAK_ROUTING_TIMEZONE,
+    defaultRoute: { providerId: null, modelId: '', effortLevel: 'medium' },
+    peakRoute: { providerId: null, modelId: '', effortLevel: 'low' },
+    abstractRoute: { providerId: null, modelId: '', effortLevel: 'xhigh' },
+    classifier: {
+      enabled: true,
+      providerId: null,
+      modelId: '',
+      timeoutMs: 2500,
+      stickyMinutes: 30,
+      minConfidence: 0.6,
+      maxInputChars: 4000,
+    },
+    peakWindows: DEFAULT_PEAK_WINDOWS.map(window => ({ ...window, weekdays: [...window.weekdays] })),
+    holidays: [...PEAK_ROUTING_2026_HOLIDAYS],
+  }
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return !!value && typeof value === 'object' && !Array.isArray(value)
+}
+
+function isEffort(value: unknown): value is ModelReasoningEffort {
+  return typeof value === 'string' && (MODEL_REASONING_EFFORTS as readonly string[]).includes(value)
+}
+
+function normalizeProviderId(value: unknown): string | null | undefined {
+  if (value === null) return null
+  if (typeof value !== 'string') return undefined
+  const trimmed = value.trim()
+  return trimmed ? trimmed.slice(0, 200) : null
+}
+
+export function normalizeHolidayList(value: unknown): string[] {
+  if (!Array.isArray(value)) return []
+  const dates = new Set<string>()
+  for (const item of value) {
+    if (typeof item !== 'string') continue
+    const date = item.trim()
+    if (!isValidDateOnly(date)) continue
+    dates.add(date)
+    if (dates.size >= 366) break
+  }
+  return [...dates].sort()
+}
+
+export function isValidDateOnly(value: string): boolean {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false
+  const [year, month, day] = value.split('-').map(Number)
+  if (!year || !month || !day) return false
+  const date = new Date(Date.UTC(year, month - 1, day))
+  return date.getUTCFullYear() === year
+    && date.getUTCMonth() === month - 1
+    && date.getUTCDate() === day
+}
+
+function isValidTime(value: string): boolean {
+  return /^([01]\d|2[0-3]):[0-5]\d$/.test(value)
+}
+
+function timeToMinutes(value: string): number {
+  const [hour, minute] = value.split(':').map(Number)
+  return hour! * 60 + minute!
+}
+
+function normalizeWindow(value: unknown): PeakRoutingWindow | null {
+  if (!isRecord(value)) return null
+  if (!Array.isArray(value.weekdays)) return null
+  const weekdays = [...new Set(
+    value.weekdays.filter((day): day is number => typeof day === 'number' && Number.isInteger(day) && day >= 1 && day <= 7),
+  )].sort((a, b) => a - b)
+  if (weekdays.length === 0) return null
+  if (typeof value.start !== 'string' || typeof value.end !== 'string') return null
+  if (!isValidTime(value.start) || !isValidTime(value.end)) return null
+  if (timeToMinutes(value.start) >= timeToMinutes(value.end)) return null
+  return { weekdays, start: value.start, end: value.end }
+}
+
+function normalizeSelection(value: unknown, fallback: PeakRoutingSelection): PeakRoutingSelection | null {
+  if (!isRecord(value)) return null
+  const providerId = normalizeProviderId(value.providerId)
+  if (providerId === undefined) return null
+  const modelId = typeof value.modelId === 'string' ? value.modelId.trim() : ''
+  if (!modelId || modelId.length > 200) return null
+  const effortLevel = isEffort(value.effortLevel)
+    ? value.effortLevel
+    : fallback.effortLevel
+  const openAIFastMode = typeof value.openAIFastMode === 'boolean' ? value.openAIFastMode : undefined
+  return {
+    providerId,
+    modelId,
+    effortLevel,
+    ...(openAIFastMode !== undefined ? { openAIFastMode } : {}),
+  }
+}
+
+export type PeakRoutingNormalization =
+  | { ok: true; config: PeakRoutingConfig }
+  | { ok: false; errors: string[] }
+
+/**
+ * Normalize a stored or submitted config. Missing fields fall back to `base`
+ * (the current config, or the defaults) so a hand-edited file and an older
+ * desktop build both stay loadable.
+ */
+export function normalizePeakRoutingConfig(value: unknown, base: PeakRoutingConfig = defaultPeakRoutingConfig()): PeakRoutingNormalization {
+  if (!isRecord(value)) return { ok: false, errors: ['config must be an object'] }
+  const errors: string[] = []
+
+  const defaultRoute = normalizeSelection(value.defaultRoute, base.defaultRoute)
+  const peakRoute = normalizeSelection(value.peakRoute, base.peakRoute)
+  const abstractRoute = normalizeSelection(value.abstractRoute, base.abstractRoute)
+  if (!defaultRoute) errors.push('defaultRoute is invalid')
+  if (!peakRoute) errors.push('peakRoute is invalid')
+  if (!abstractRoute) errors.push('abstractRoute is invalid')
+
+  const rawClassifier = isRecord(value.classifier) ? value.classifier : {}
+  const classifierBase = base.classifier
+  const classifierEnabled = typeof rawClassifier.enabled === 'boolean' ? rawClassifier.enabled : classifierBase.enabled
+  const classifierProviderId = normalizeProviderId(rawClassifier.providerId)
+  const classifierModelId = typeof rawClassifier.modelId === 'string' ? rawClassifier.modelId.trim() : classifierBase.modelId
+  const classifier: PeakRoutingClassifierConfig = {
+    enabled: classifierEnabled,
+    providerId: classifierProviderId === undefined ? classifierBase.providerId : classifierProviderId,
+    modelId: classifierModelId.slice(0, 200),
+    timeoutMs: clampInt(rawClassifier.timeoutMs, 500, 15_000, classifierBase.timeoutMs),
+    stickyMinutes: clampInt(rawClassifier.stickyMinutes, 1, 240, classifierBase.stickyMinutes),
+    minConfidence: clampNumber(rawClassifier.minConfidence, 0, 1, classifierBase.minConfidence),
+    maxInputChars: clampInt(rawClassifier.maxInputChars, 200, 8000, classifierBase.maxInputChars),
+  }
+  if (classifier.enabled && !classifier.modelId) errors.push('classifier.modelId is required')
+
+  let peakWindows = base.peakWindows
+  if (Array.isArray(value.peakWindows)) {
+    const windows = value.peakWindows.map(normalizeWindow).filter((window): window is PeakRoutingWindow => window !== null)
+    if (windows.length === 0) errors.push('peakWindows must contain at least one window')
+    else if (windows.length > 4) errors.push('peakWindows accepts at most four windows')
+    else peakWindows = windows
+  }
+
+  const holidays = Array.isArray(value.holidays)
+    ? normalizeHolidayList(value.holidays)
+    : base.holidays
+
+  if (typeof value.enabled === 'boolean' && value.enabled) {
+    for (const [name, route] of [['defaultRoute', defaultRoute], ['peakRoute', peakRoute], ['abstractRoute', abstractRoute]] as const) {
+      if (route && !route.modelId) errors.push(`${name}.modelId is required when enabled`)
+    }
+  }
+
+  if (errors.length > 0) return { ok: false, errors }
+
+  return {
+    ok: true,
+    config: {
+      schemaVersion: PEAK_ROUTING_SCHEMA_VERSION,
+      enabled: typeof value.enabled === 'boolean' ? value.enabled : base.enabled,
+      timezone: PEAK_ROUTING_TIMEZONE,
+      defaultRoute: defaultRoute!,
+      peakRoute: peakRoute!,
+      abstractRoute: abstractRoute!,
+      classifier,
+      peakWindows,
+      holidays,
+      ...(typeof value.updatedAt === 'string' ? { updatedAt: value.updatedAt } : {}),
+    },
+  }
+}
+
+function clampInt(value: unknown, min: number, max: number, fallback: number): number {
+  if (typeof value !== 'number' || !Number.isFinite(value)) return fallback
+  return Math.min(max, Math.max(min, Math.round(value)))
+}
+
+function clampNumber(value: unknown, min: number, max: number, fallback: number): number {
+  if (typeof value !== 'number' || !Number.isFinite(value)) return fallback
+  return Math.min(max, Math.max(min, value))
+}
+
+const WEEKDAY_BY_SHORT_NAME: Record<string, number> = {
+  Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7,
+}
+
+export type ShanghaiClock = {
+  date: string
+  weekday: number
+  /** Minutes since local midnight. */
+  minutes: number
+}
+
+const SHANGHAI_FORMATTER = new Intl.DateTimeFormat('en-US', {
+  timeZone: PEAK_ROUTING_TIMEZONE,
+  weekday: 'short',
+  year: 'numeric',
+  month: '2-digit',
+  day: '2-digit',
+  hour: '2-digit',
+  minute: '2-digit',
+  hourCycle: 'h23',
+})
+
+export function getShanghaiClock(now: Date): ShanghaiClock {
+  const parts = new Map(SHANGHAI_FORMATTER.formatToParts(now).map(part => [part.type, part.value]))
+  const year = Number(parts.get('year'))
+  const month = Number(parts.get('month'))
+  const day = Number(parts.get('day'))
+  const hour = Number(parts.get('hour'))
+  const minute = Number(parts.get('minute'))
+  const weekday = WEEKDAY_BY_SHORT_NAME[parts.get('weekday') ?? ''] ?? 1
+  return {
+    date: `${String(year).padStart(4, '0')}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`,
+    weekday,
+    minutes: hour * 60 + minute,
+  }
+}
+
+export type PeakWindowStatus = {
+  isPeak: boolean
+  isHoliday: boolean
+  clock: ShanghaiClock
+  /** Epoch ms of the current window's end, when inside one. */
+  windowEnd?: number
+  /** Epoch ms of the next peak window start, when outside one. */
+  nextWindowStart?: number
+}
+
+export function getPeakWindowStatus(config: PeakRoutingConfig, now: Date = new Date()): PeakWindowStatus {
+  const clock = getShanghaiClock(now)
+  const isHoliday = config.holidays.includes(clock.date)
+  const active = config.peakWindows.find(window =>
+    !isHoliday &&
+    window.weekdays.includes(clock.weekday) &&
+    timeToMinutes(window.start) <= clock.minutes &&
+    clock.minutes < timeToMinutes(window.end),
+  )
+  if (active) {
+    return {
+      isPeak: true,
+      isHoliday,
+      clock,
+      windowEnd: shanghaiWallTimeToEpoch(clock.date, timeToMinutes(active.end)),
+    }
+  }
+  return {
+    isPeak: false,
+    isHoliday,
+    clock,
+    nextWindowStart: findNextWindowStart(config, now.getTime(), clock),
+  }
+}
+
+/** Asia/Shanghai has no DST, so its wall clock maps to UTC by a fixed −8h. */
+function shanghaiWallTimeToEpoch(date: string, minutes: number): number {
+  const [year, month, day] = date.split('-').map(Number)
+  return Date.UTC(year!, month! - 1, day!, Math.floor(minutes / 60) - 8, minutes % 60)
+}
+
+function addDays(date: string, days: number): string {
+  const [year, month, day] = date.split('-').map(Number)
+  const shifted = new Date(Date.UTC(year!, month! - 1, day! + days))
+  return `${shifted.getUTCFullYear()}-${String(shifted.getUTCMonth() + 1).padStart(2, '0')}-${String(shifted.getUTCDate()).padStart(2, '0')}`
+}
+
+function weekdayOf(date: string): number {
+  const [year, month, day] = date.split('-').map(Number)
+  const value = new Date(Date.UTC(year!, month! - 1, day!)).getUTCDay()
+  return value === 0 ? 7 : value
+}
+
+function findNextWindowStart(config: PeakRoutingConfig, nowEpoch: number, clock: ShanghaiClock): number | undefined {
+  for (let offset = 0; offset <= 10; offset += 1) {
+    const date = addDays(clock.date, offset)
+    if (config.holidays.includes(date)) continue
+    const weekday = weekdayOf(date)
+    for (const window of config.peakWindows) {
+      if (!window.weekdays.includes(weekday)) continue
+      const start = shanghaiWallTimeToEpoch(date, timeToMinutes(window.start))
+      if (start > nowEpoch) return start
+    }
+  }
+  return undefined
+}
+
+export function formatPeakWindow(window: PeakRoutingWindow): string {
+  const days = window.weekdays.map(day => ['一', '二', '三', '四', '五', '六', '日'][day - 1]).join('')
+  return `周${days} ${window.start}–${window.end}`
+}
