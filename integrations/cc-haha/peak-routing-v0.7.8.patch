+        if (!normalized.ok) throw new Error(normalized.errors.join('; '))
+        config = normalized.config
+      }
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
+        // First run: keep the effective defaults without writing state.
+      } else {
+        await this.quarantineConfig(filePath, error)
+        config = defaults
+        exists = false
+        revision = '0'
+      }
+    }
+    return { config, revision, exists }
+  }
+
+  async isEnabled(): Promise<boolean> {
+    return (await this.getConfig()).config.enabled
+  }
+
+  async getStatus(now: Date = this.clock()): Promise<PeakRoutingStatus> {
+    const { config, revision, exists } = await this.getConfig()
+    const peak = getPeakWindowStatus(config, now)
+    const classifierReady = Boolean(config.classifier.enabled && config.classifier.providerId && config.classifier.modelId)
+    return {
+      now: now.toISOString(),
+      revision,
+      exists,
+      enabled: config.enabled,
+      inPeakWindow: peak.isPeak,
+      isHoliday: peak.isHoliday,
+      windowEnd: peak.windowEnd ? new Date(peak.windowEnd).toISOString() : null,
+      nextWindowStart: peak.nextWindowStart ? new Date(peak.nextWindowStart).toISOString() : null,
+      classifier: {
+        ready: classifierReady,
+        lastLatencyMs: this.lastLatencyMs,
+        lastDegradedReason: this.lastDegradedReason,
+      },
+    }
+  }
+
+  async getCatalog(): Promise<PeakRoutingCatalog> {
+    const models = await listSessionModels()
+    const byProvider = new Map<string, PeakRoutingCatalog['providers'][number]>()
+    for (const model of models) {
+      if (model.providerId === null) continue
+      const provider = byProvider.get(model.providerId) ?? {
+        providerId: model.providerId,
+        providerName: model.providerName,
+        models: [],
+      }
+      if (!provider.models.some(entry => entry.modelId === model.modelId)) {
+        provider.models.push({
+          modelId: model.modelId,
+          modelName: model.modelName,
+          supportedEfforts: [...model.supportedEfforts],
+          ...(model.defaultEffort ? { defaultEffort: model.defaultEffort } : {}),
+        })
+      }
+      byProvider.set(model.providerId, provider)
+    }
+    return {
+      providers: [...byProvider.values()].sort((a, b) => a.providerName.localeCompare(b.providerName)),
+    }
+  }
+
+  async saveConfig(input: unknown, expectedRevision?: string): Promise<{ config: PeakRoutingConfig; revision: string }> {
+    return this.mutateConfig(() => input, expectedRevision)
+  }
+
+  /**
+   * The phone's master switch: change only `enabled`, never the routes.
+   * Turning the feature off must succeed even when a configured model has
+   * since disappeared from its provider — otherwise the user cannot disable it.
+   */
+  async setEnabled(
+    enabled: boolean,
+    expectedRevision?: string,
+  ): Promise<{ config: PeakRoutingConfig; revision: string }> {
+    return this.mutateConfig(
+      current => ({ ...current, enabled }),
+      expectedRevision,
+      { validateRoutes: enabled },
+    )
+  }
+
+  /**
+   * Read, revision-check, normalize, validate and write under one write lock.
+   * Keeping the read inside the lock closes the window where a phone toggle
+   * and a desktop save could each pass the revision check and overwrite
+   * the other's change.
+   */
+  private async mutateConfig(
+    mutate: (current: PeakRoutingConfig) => unknown,
+    expectedRevision?: string,
+    options: { validateRoutes?: boolean } = {},
+  ): Promise<{ config: PeakRoutingConfig; revision: string }> {
+    const filePath = this.getConfigPath()
+    return this.withWriteLock(filePath, async () => {
+      const current = await this.getConfig()
+      if (expectedRevision !== undefined && expectedRevision !== current.revision) {
+        throw new ApiError(409, 'Peak routing settings changed; reload and try again', 'PEAK_ROUTING_REVISION_CONFLICT')
+      }
+      const normalized = normalizePeakRoutingConfig(mutate(current.config), current.config)
+      if (!normalized.ok) {
+        throw new ApiError(400, normalized.errors.join('; '), 'PEAK_ROUTING_INVALID')
+      }
+      if (options.validateRoutes !== false) {
+        await this.assertRoutesAvailable(normalized.config)
+      }
+      const next: PeakRoutingConfig = {
+        ...normalized.config,
+        updatedAt: this.clock().toISOString(),
+      }
+      await fs.mkdir(this.getStateDir(), { recursive: true, mode: 0o700 })
+      const temporary = `${filePath}.${process.pid}.${Date.now()}.${randomBytes(4).toString('hex')}.tmp`
+      await fs.writeFile(temporary, `${JSON.stringify(next, null, 2)}\n`, { mode: 0o600 })
+      await fs.rename(temporary, filePath)
+      const stat = await fs.stat(filePath)
+      return { config: next, revision: String(Math.round(stat.mtimeMs)) }
+    })
+  }
+
+  async decideForTurn(
+    sessionId: string,
+    text: string,
+    options: { now?: Date } = {},
+  ): Promise<PeakRoutingDecision | null> {
+    const { config } = await this.getConfig()
+    if (!config.enabled) return null
+    const now = options.now ?? this.clock()
+    this.sweepSticky(now.getTime())
+
+    const sticky = this.stickyHigh.get(sessionId)
+    if (sticky && sticky.until > now.getTime()) {
+      return {
+        source: 'classifier-sticky',
+        selection: config.abstractRoute,
+        stickyUntil: sticky.until,
+      }
+    }
+
+    const peak = getPeakWindowStatus(config, now)
+    const windowRoute = peak.isPeak ? config.peakRoute : config.defaultRoute
+    const windowSource: PeakRoutingDecisionSource = peak.isPeak ? 'peak-window' : 'default'
+    const trimmed = text.trim()
+    if (
+      !config.classifier.enabled ||
+      !config.classifier.providerId ||
+      !config.classifier.modelId ||
+      trimmed.length < 16 ||
+      sameSelection(config.abstractRoute, windowRoute)
+    ) {
+      return { source: windowSource, selection: windowRoute }
+    }
+
+    const verdict = await this.classify(config, trimmed)
+    if (verdict.hit && verdict.confidence >= config.classifier.minConfidence) {
+      const until = now.getTime() + config.classifier.stickyMinutes * 60_000
+      this.stickyHigh.set(sessionId, { until, seenAt: now.getTime() })
+      return {
+        source: 'classifier-hit',
+        selection: config.abstractRoute,
+        stickyUntil: until,
+        classifier: verdict,
+      }
+    }
+    return { source: windowSource, selection: windowRoute, classifier: verdict }
+  }
+
+  async classifyForTest(text: string): Promise<ClassifierVerdict> {
+    const { config } = await this.getConfig()
+    const trimmed = text.trim()
+    if (!trimmed) return { hit: false, confidence: 0, reason: 'empty input', latencyMs: 0, degraded: 'empty' }
+    return this.classify(config, trimmed, { useCache: false })
+  }
+
+  private async classify(
+    config: PeakRoutingConfig,
+    text: string,
+    options: { useCache?: boolean } = {},
+  ): Promise<ClassifierVerdict> {
+    if (!config.classifier.providerId) {
+      return { hit: false, confidence: 0, reason: 'classifier provider is not configured', latencyMs: 0, degraded: 'missing-provider' }
+    }
+    const input = text.slice(0, config.classifier.maxInputChars)
+    const cacheKey = createHash('sha256')
+      .update(`${config.classifier.providerId}\n${config.classifier.modelId}\n${input}`)
+      .digest('hex')
+    if (options.useCache !== false) {
+      const cached = this.classifierCache.get(cacheKey)
+      if (cached && cached.expiresAt > Date.now()) return cached.verdict
+    }
+
+    const started = Date.now()
+    let provider: SavedProvider
+    try {
+      provider = await this.providers.getProvider(config.classifier.providerId)
+    } catch (error) {
+      return this.degraded(`provider unavailable: ${describeError(error)}`, started)
+    }
+
+    let result: ProviderTextCompletionResult
+    try {
+      result = await this.completion({
+        provider,
+        modelId: config.classifier.modelId,
+        system: CLASSIFIER_SYSTEM_PROMPT,
+        user: input,
+        maxTokens: 80,
+        temperature: 0,
+        reasoningEffort: 'low',
+        timeoutMs: config.classifier.timeoutMs,
+      })
+    } catch (error) {
+      return this.degraded(`classifier threw: ${describeError(error)}`, started)
+    }
+    const latencyMs = Date.now() - started
+    this.lastLatencyMs = latencyMs
+    this.lastDegradedReason = null
+
+    if (!result.ok) {
+      const verdict = this.degraded(`classifier ${result.reason}: ${result.message}`, started, latencyMs)
+      this.logDecision({
+        providerId: config.classifier.providerId,
+        modelId: config.classifier.modelId,
+        messageHash: hashShort(input),
+        chars: input.length,
+        hit: false,
+        confidence: 0,
+        latencyMs,
+        degraded: verdict.degraded,
+      })
+      return verdict
+    }
+
+    const parsed = parseClassifierAnswer(result.text)
+    const verdict: ClassifierVerdict = parsed
+      ? { ...parsed, latencyMs }
+      : { hit: false, confidence: 0, reason: 'unparseable classifier answer', latencyMs, degraded: 'parse' }
+    if (options.useCache !== false) {
+      this.classifierCache.set(cacheKey, { verdict, expiresAt: Date.now() + CLASSIFIER_CACHE_TTL_MS })
+      this.trimClassifierCache()
+    }
+    this.logDecision({
+      providerId: config.classifier.providerId,
+      modelId: config.classifier.modelId,
+      messageHash: hashShort(input),
+      chars: input.length,
+      hit: verdict.hit,
+      confidence: verdict.confidence,
+      latencyMs,
+      degraded: verdict.degraded,
+    })
+    return verdict
+  }
+
+  private degraded(reason: string, started: number, latencyMs = Date.now() - started): ClassifierVerdict {
+    this.lastLatencyMs = latencyMs
+    this.lastDegradedReason = reason
+    const now = Date.now()
+    const last = this.failureLogTimes.get(reason) ?? 0
+    if (now - last >= FAILURE_LOG_INTERVAL_MS) {
+      this.failureLogTimes.set(reason, now)
+      this.appendLog(`[${new Date(now).toISOString()}] classifier degraded: ${reason}`)
+    }
+    return { hit: false, confidence: 0, reason, latencyMs, degraded: reason }
+  }
+
+  private async assertRoutesAvailable(config: PeakRoutingConfig): Promise<void> {
+    const catalog = await this.getCatalog()
+    const providers = new Map(catalog.providers.map(provider => [provider.providerId, provider]))
+    const routes: Array<[string, PeakRoutingSelection]> = [
+      ['defaultRoute', config.defaultRoute],
+      ['peakRoute', config.peakRoute],
+      ['abstractRoute', config.abstractRoute],
+    ]
+    for (const [name, route] of routes) {
+      if (!route.modelId) {
+        if (config.enabled) throw new ApiError(400, `${name} requires a model`, 'PEAK_ROUTING_INVALID')
+        continue
+      }
+      if (route.providerId === null) continue
+      const provider = providers.get(route.providerId)
+      if (!provider) throw new ApiError(400, `${name} provider is unavailable: ${route.providerId}`, 'PEAK_ROUTING_INVALID')
+      const model = provider.models.find(entry => entry.modelId === route.modelId)
+      if (!model) throw new ApiError(400, `${name} model is unavailable: ${route.modelId}`, 'PEAK_ROUTING_INVALID')
+      if (model.supportedEfforts.length > 0 && !model.supportedEfforts.includes(route.effortLevel)) {
+        throw new ApiError(400, `${name} effort is not supported by ${route.modelId}: ${route.effortLevel}`, 'PEAK_ROUTING_INVALID')
+      }
+    }
+    const { classifier } = config
+    if (classifier.enabled && classifier.providerId && classifier.modelId) {
+      const provider = providers.get(classifier.providerId)
+      const model = provider?.models.find(entry => entry.modelId === classifier.modelId)
+      if (!model) throw new ApiError(400, 'classifier model is unavailable', 'PEAK_ROUTING_INVALID')
+    }
+  }
+
+  private async resolveDefaultConfig(): Promise<PeakRoutingConfig> {
+    const base = defaultPeakRoutingConfig()
+    let providers: SavedProvider[] = []
+    try {
+      providers = (await this.providers.listProviders()).providers
+    } catch {
+      return base
+    }
+    const deepseek = providers.find(provider => provider.presetId === 'deepseek')
+    const flashModel = deepseek ? pickFlashModel(deepseek) : ''
+    if (!deepseek || !flashModel) return base
+    return {
+      ...base,
+      defaultRoute: { providerId: deepseek.id, modelId: flashModel, effortLevel: 'medium' },
+      peakRoute: { providerId: 'openai-official', modelId: 'gpt-6-luna', effortLevel: 'low' },
+      abstractRoute: { providerId: 'openai-official', modelId: 'gpt-6-astra', effortLevel: 'xhigh' },
+      classifier: {
+        ...base.classifier,
+        providerId: deepseek.id,
+        modelId: flashModel,
+      },
+    }
+  }
+
+  private async quarantineConfig(filePath: string, error: unknown): Promise<void> {
+    const backup = `${filePath}.invalid-${Date.now()}-${randomBytes(3).toString('hex')}`
+    try {
+      await fs.rename(filePath, backup)
+      this.appendLog(`[${new Date().toISOString()}] recovered invalid peak-routing.json -> ${backup}: ${describeError(error)}`)
+    } catch (renameError) {
+      this.appendLog(`[${new Date().toISOString()}] invalid peak-routing.json could not be quarantined: ${describeError(renameError)}`)
+    }
+  }
+
+  private async withWriteLock<T>(filePath: string, task: () => Promise<T>): Promise<T> {
+    const previous = this.writeLocks.get(filePath) ?? Promise.resolve()
+    const next = previous.catch(() => {}).then(task)
+    const tracked = next.then(() => {}, () => {})
+    this.writeLocks.set(filePath, tracked)
+    try {
+      return await next
+    } finally {
+      if (this.writeLocks.get(filePath) === tracked) this.writeLocks.delete(filePath)
+    }
+  }
+
+  private sweepSticky(now: number): void {
+    for (const [sessionId, entry] of this.stickyHigh) {
+      if (entry.until <= now && now - entry.seenAt > STICKY_SWEEP_MS) this.stickyHigh.delete(sessionId)
+    }
+  }
+
+  private trimClassifierCache(): void {
+    while (this.classifierCache.size > CLASSIFIER_CACHE_MAX) {
+      const oldest = this.classifierCache.keys().next().value
+      if (oldest === undefined) break
+      this.classifierCache.delete(oldest)
+    }
+  }
+
+  private logDecision(entry: {
+    providerId: string
+    modelId: string
+    messageHash: string
+    chars: number
+    hit: boolean
+    confidence: number
+    latencyMs: number
+    degraded?: string
+  }): void {
+    this.appendLog(`[${new Date().toISOString()}] classify ${JSON.stringify(entry)}`)
+  }
+
+  private appendLog(line: string): void {
+    const logPath = this.getLogPath()
+    void (async () => {
+      try {
+        await fs.mkdir(this.getStateDir(), { recursive: true, mode: 0o700 })
+        try {
+          const stat = await fs.stat(logPath)
+          if (stat.size > LOG_MAX_BYTES) await fs.rename(logPath, `${logPath}.1`)
+        } catch (error) {
+          if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error
+        }
+        await fs.appendFile(logPath, `${line}\n`, { mode: 0o600 })
+      } catch {
+        // Diagnostics must never affect routing.
+      }
+    })()
+  }
+
+  /** Test seam: replace the provider completion transport. */
+  __setCompletionForTests(fn: CompletionFn | null): void {
+    this.completion = fn ?? providerTextCompletion
+  }
+
+  __setClockForTests(fn: ClockFn | null): void {
+    this.clock = fn ?? (() => new Date())
+  }
+
+  __resetForTests(): void {
+    this.completion = providerTextCompletion
+    this.clock = () => new Date()
+    this.stickyHigh.clear()
+    this.classifierCache.clear()
+    this.failureLogTimes.clear()
+    this.lastLatencyMs = null
+    this.lastDegradedReason = null
+  }
+}
+
+function pickFlashModel(provider: SavedProvider): string {
+  const candidates = [
+    ...Object.values(provider.models).filter((model): model is string => typeof model === 'string' && !!model.trim()),
+    ...(provider.modelList ?? []).map(model => model.id),
+  ]
+  const unique = [...new Set(candidates.map(model => model.trim()).filter(Boolean))]
+  return unique.find(model => model === 'deepseek-v4-flash')
+    ?? unique.find(model => /flash/i.test(model))
+    ?? provider.models.main?.trim()
+    ?? ''
+}
+
+function sameSelection(a: PeakRoutingSelection, b: PeakRoutingSelection): boolean {
+  return a.providerId === b.providerId &&
+    a.modelId === b.modelId &&
+    a.effortLevel === b.effortLevel &&
+    (a.openAIFastMode ?? false) === (b.openAIFastMode ?? false)
+}
+
+function parseClassifierAnswer(text: string): { hit: boolean; confidence: number; reason: string } | null {
+  const trimmed = text.trim()
+  if (!trimmed) return null
+  const jsonStart = trimmed.indexOf('{')
+  const jsonEnd = trimmed.lastIndexOf('}')
+  if (jsonStart >= 0 && jsonEnd > jsonStart) {
+    try {
+      const parsed: unknown = JSON.parse(trimmed.slice(jsonStart, jsonEnd + 1))
+      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
+        const record = parsed as Record<string, unknown>
+        if (typeof record.highAbstraction === 'boolean') {
+          const confidence = typeof record.confidence === 'number' && Number.isFinite(record.confidence)
+            ? Math.min(1, Math.max(0, record.confidence))
+            : 0.7
+          const reason = typeof record.reason === 'string' ? record.reason.slice(0, 80) : ''
+          return { hit: record.highAbstraction, confidence, reason }
+        }
+      }
+    } catch {
+      // Fall through to the tolerant pattern below.
+    }
+  }
+  const highMatch = /"highAbstraction"\s*:\s*(true|false)/i.exec(trimmed)
+  if (!highMatch) return null
+  const confidenceMatch = /"confidence"\s*:\s*([0-9]*\.?[0-9]+)/i.exec(trimmed)
+  const confidence = confidenceMatch ? Math.min(1, Math.max(0, Number(confidenceMatch[1]))) : 0.7
+  return { hit: highMatch[1]!.toLowerCase() === 'true', confidence, reason: 'pattern match' }
+}
+
+function hashShort(value: string): string {
+  return createHash('sha256').update(value).digest('hex').slice(0, 10)
+}
+
+function describeError(error: unknown): string {
+  return error instanceof Error ? error.message : String(error)
+}
+
+export const peakRoutingService = new PeakRoutingService()
+export { PeakRoutingService }
+export { PEAK_ROUTING_TIMEZONE }
