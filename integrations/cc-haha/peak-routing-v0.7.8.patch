new file mode 100644
index 0000000..ce65ade
--- /dev/null
+++ b/mobile/src/ui/computer/usePeakRouting.ts
@@ -0,0 +1,82 @@
+import { useCallback, useState } from 'react'
+import { useFocusEffect } from 'expo-router'
+import { ApiError, type ApiClient } from '../../core/client'
+import { errorText } from '../theme'
+import type { PeakRoutingStatus } from './peakRoutingModel'
+
+type ToggleResponse = { ok: true; enabled: boolean; revision: string }
+
+/**
+ * The phone's view of peak routing: status + the master switch only.
+ * Route editing stays on the computer; the phone never sends the full config.
+ */
+export function usePeakRouting(client: ApiClient | null) {
+  const [status, setStatus] = useState<PeakRoutingStatus | null>(null)
+  const [error, setError] = useState<string | null>(null)
+  const [busy, setBusy] = useState(false)
+
+  const load = useCallback(async (signal?: AbortSignal): Promise<PeakRoutingStatus | null> => {
+    if (!client) return null
+    const next = await client.get<PeakRoutingStatus>(
+      '/api/peak-routing/status',
+      signal ? { signal } : undefined,
+    )
+    if (signal?.aborted) return null
+    setStatus(next)
+    setError(null)
+    return next
+  }, [client])
+
+  useFocusEffect(
+    useCallback(() => {
+      const controller = new AbortController()
+      void load(controller.signal).catch((e) => {
+        if (!controller.signal.aborted) setError(errorText(e))
+      })
+      return () => controller.abort()
+    }, [load]),
+  )
+
+  const setEnabled = useCallback(async (enabled: boolean) => {
+    if (!client || busy) return
+    setBusy(true)
+    setError(null)
+    try {
+      const result = await client.patch<ToggleResponse>('/api/peak-routing', {
+        enabled,
+        ...(status?.revision ? { expectedRevision: status.revision } : {}),
+      })
+      setStatus((current) => current
+        ? { ...current, enabled: result.enabled, revision: result.revision }
+        : current)
+    } catch (e) {
+      if (e instanceof ApiError && e.status === 409) {
+        try {
+          const fresh = await load()
+          // Turning off must always be possible: retry once with the new
+          // revision. Turning on waits for the user, so a stale phone cannot
+          // silently override a newer desktop choice.
+          if (!enabled && fresh) {
+            const retry = await client.patch<ToggleResponse>('/api/peak-routing', {
+              enabled: false,
+              expectedRevision: fresh.revision,
+            })
+            setStatus((current) => current
+              ? { ...current, enabled: retry.enabled, revision: retry.revision }
+              : current)
+            return
+          }
+          setError('设置已在别处修改，请重试')
+        } catch (nextError) {
+          setError(errorText(nextError))
+        }
+      } else {
+        setError(errorText(e))
+      }
+    } finally {
+      setBusy(false)
+    }
+  }, [client, busy, status?.revision, load])
+
+  return { status, error, busy, setEnabled }
+}
