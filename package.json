{
  "name": "dsh-peak-valley-router",
  "version": "0.9.0",
  "description": "Peak/off-peak multi-model routing policy engine for DeepSeek Harness, with a Settings GUI.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node src/build-client.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/text.js",
    "test": "node scripts/roundtrip.test.mjs && node scripts/copy.test.mjs",
    "verify": "node scripts/verify.mjs && node scripts/roundtrip.test.mjs && node scripts/copy.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.1.7-rc.1 || 0.2.0-rc.2"
  }
}
